# Copy this file to .env.local and fill in what you have.
# The app runs fully without any of these set — it falls back to an
# in-memory seed dataset — but nothing persists across a server restart
# until MONGODB_URI is configured.

# MongoDB Atlas connection string. Leave empty to use the in-memory demo data.
MONGODB_URI=
MONGODB_DB_NAME=aci

# Admin access: /admin is open to the by.narras accounts listed in
# src/config/admins.ts (sign in with email/password or Google). Add more
# superadmins here, comma-separated, without a code change.
SUPERADMIN_EMAILS=

# Required by NextAuth for signing session tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional: enables real file uploads for shoppable image photos.
# Without it, the "Upload a look" form falls back to picking a sample
# image or pasting an external URL.
BLOB_READ_WRITE_TOKEN=

# Optional: shared click rate limiting across serverless instances.
# Create a free database at https://console.upstash.com (Redis → REST API)
# and paste its REST URL and token. Without these, a per-instance in-memory
# limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: how long view/click analytics events are kept (days, default
# 365). Applied by `npm run db:indexes` via a MongoDB TTL index.
ANALYTICS_RETENTION_DAYS=

# by.narras "Continue with Google" (optional, free). Create an OAuth client
# ("Web application") at https://console.cloud.google.com/apis/credentials
# with this redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# by.narras password-reset emails via Resend (free: 3,000/month).
# https://resend.com/api-keys — RESEND_FROM must use a domain verified in
# Resend, e.g. "by.narras <noreply@yourdomain.com>". Without these, local
# development prints the reset link to the server log instead.
RESEND_API_KEY=
RESEND_FROM=
